{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOID",
  "version": "0.2.0-alpha",
  "identifier": "com.void.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "capabilities": ["main"]
    },
    "windows": [
      {
        "title": "VOID",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "SCamposs",
    "shortDescription": "A focused desktop toolkit for typing, audio visualization, and play.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMkM0QjkwQkU4NERCMTIKUldRUzI0UytrRXNzb1FaM3kzZll5ZE85KzdxeHlmaXVjd1hpV3o4NkVKbnhFcWdkTE55cUk4UWIK",
      "endpoints": [
        "https://raw.githubusercontent.com/SCamposs/void/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
